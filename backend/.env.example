# ============================================================
# Finora Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# PostgreSQL connection string (Supabase format example below)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/finora_db?schema=public"

# --- JWT Authentication ---
# A long, random secret string for signing JWT tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"
# Token expiry (24 hours)
JWT_EXPIRES_IN="24h"

# --- Server ---
PORT=5000
# Allowed frontend origin for CORS (no trailing slash)
CLIENT_URL="http://localhost:5173"

# --- bcrypt ---
BCRYPT_SALT_ROUNDS=10

# --- Initial Admin Seed ---
# Used by the seed script to create the first admin account
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@finora.app"
SEED_ADMIN_PASSWORD="Admin@123456"
